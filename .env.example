# =============================================================================
# Lead Generator — environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# --- Application ---
# Secret used to sign JWTs. Generate a long random string.
SECRET_KEY=change-me-to-a-long-random-secret
# 32-url-safe-base64-encoded bytes for Fernet (OAuth token encryption).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=generate-a-fernet-key
ENVIRONMENT=development
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
API_PREFIX=/api

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://leadgen:leadgen@localhost:5432/leadgen
# Used by docker-compose postgres service
POSTGRES_USER=leadgen
POSTGRES_PASSWORD=leadgen
POSTGRES_DB=leadgen
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Auth ---
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# Optional: set to true to require email verification before login
REQUIRE_EMAIL_VERIFICATION=false

# --- Google OAuth / Gmail API ---
# Create credentials in Google Cloud Console. See docs/google-oauth-setup.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/email-accounts/gmail/callback
# Space-separated OAuth scopes. Gmail send + user email are required.
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/userinfo.profile openid

# --- AI provider (Claude by default; OpenAI-compatible providers also work) ---
# Leave empty to keep AI features in a "configuration required" state.
# The app will NOT invent fake AI results when this is unset.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_API_BASE=https://api.anthropic.com
AI_MODEL=claude-opus-5-5
AI_TEMPERATURE=0.4
AI_TIMEOUT_SECONDS=60

# --- Google Maps leads: built-in scraper (free) or Apify (each user can switch in AI & settings) ---
# Default for users who haven't chosen: scraper | apify | auto (Apify when a token is set)
SCRAPER_PROVIDER=scraper
# Built-in scraper: business websites checked in parallel for emails, pages per site, seconds per page
SCRAPER_SITE_WORKERS=10
SCRAPER_SITE_PAGES=3
SCRAPER_SITE_TIMEOUT_SECONDS=8
APIFY_TOKEN=
APIFY_ACTOR_ID=compass~crawler-google-places

# --- Scraping / Selenium ---
HEADLESS=true
BROWSER=chrome
# Optional explicit chromedriver path. Leave empty to use Selenium Manager.
CHROMEDRIVER_PATH=
# Optional Chrome/Chromium executable, e.g. /usr/bin/chromium on Debian/Ubuntu. Empty = auto-detect.
CHROME_BINARY=
SELENIUM_PAGE_LOAD_TIMEOUT=45
SELENIUM_IMPLICIT_WAIT=0
SCRAPE_MAX_RESULTS=200
SCRAPE_SCROLL_PAUSE_SECONDS=1.5
# Delay range between Maps result detail opens (seconds)
SCRAPE_MIN_DELAY=1.0
SCRAPE_MAX_DELAY=3.0

# --- Website audit (PDF audit + outreach email) ---
# Claude analyses the site itself; audit generation can take a few minutes on large sites
AUDIT_AI_TIMEOUT_SECONDS=240

# --- Website crawler ---
CRAWL_MAX_PAGES=5
CRAWL_TIMEOUT_SECONDS=20
CRAWL_RESPECT_ROBOTS=true
CRAWL_USER_AGENT=LeadGeneratorBot/1.0 (+https://localhost)

# --- Email sending defaults (overridable per campaign / user settings) ---
DEFAULT_DAILY_SEND_LIMIT=50
DEFAULT_HOURLY_SEND_LIMIT=20
DEFAULT_MIN_SEND_DELAY_SECONDS=60
DEFAULT_MAX_SEND_DELAY_SECONDS=180
# Hard safety ceiling — the API rejects higher values
MAX_ALLOWED_DAILY_SEND_LIMIT=500
MAX_ALLOWED_HOURLY_SEND_LIMIT=80
MIN_ALLOWED_SEND_DELAY_SECONDS=15

# --- Optional email verification provider ---
# Leave empty; verification stays optional and emails remain "not_checked".
EMAIL_VERIFIER_PROVIDER=
EMAIL_VERIFIER_API_KEY=

# --- Email tracking (see docs/website-audit.md) ---
# Public https address that serves only /t/ (open-tracking image, unsubscribe page), e.g. a Cloudflare Tunnel.
# Empty = opens aren't tracked and the unsubscribe link uses FRONTEND_URL.
PUBLIC_URL=
ENABLE_EMAIL_OPEN_TRACKING=true
# Seconds between IMAP checks of SMTP inboxes for replies and bounces (0 = off)
INBOX_CHECK_SECONDS=300

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side API URL used by Next.js route proxies if needed
API_INTERNAL_URL=http://localhost:8000
