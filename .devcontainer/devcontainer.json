{
  // GitHub Codespaces / Dev Containers: the whole app with no local setup.
  // Open the repo on GitHub -> Code -> Codespaces -> Create codespace.
  // When the "Ports" tab shows port 3000, open it: log in with demo@leadgen.local / DemoPass123!
  "name": "Lead Generator",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [3000, 8025, 8000],
  "portsAttributes": {
    "3000": { "label": "App", "onAutoForward": "openBrowser" },
    "8025": { "label": "Test inbox (Mailpit)", "onAutoForward": "notify" },
    "8000": { "label": "API", "onAutoForward": "silent" }
  },
  "otherPortsAttributes": { "onAutoForward": "ignore" },
  "customizations": {
    "codespaces": { "openFiles": ["docs/codespaces.md"] }
  }
}
